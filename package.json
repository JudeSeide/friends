{
  "name": "friends",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "tunnel": "npm run build && concurrently -n preview,ngrok -c blue,green \"vite preview --host --port 5173\" \"sleep 2 && ngrok http 5173\"",
    "build": "tsc -b && vite build",
    "prod": "vite preview --port 5173",
    "prod:host": "npm run build && npm run prod -- --host",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\""
  },
